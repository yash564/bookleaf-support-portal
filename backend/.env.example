# --- Database ---
# asyncpg driver URL. Local docker-compose default below; use your Neon URL in production.
DATABASE_URL=postgresql+asyncpg://bookleaf:bookleaf@localhost:5433/bookleaf

# --- Auth ---
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_MINUTES=10080   # 7 days

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ORIGINS=http://localhost:3000

# --- AI (Anthropic). Never expose to the frontend. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_ENABLED=true
AI_TIMEOUT_SECONDS=20

# --- Misc ---
APP_ENV=development
LOG_LEVEL=INFO
